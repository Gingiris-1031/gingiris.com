---
import { Image } from "astro:assets";
import wechatQr from "../../assets/qr/iris-wechat.png";
import {
  isSiteLocale,
  servicesContentByLocale,
  supportedLocales,
  type SiteLocale,
} from "@yipei/site-content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!localeParam || !isSiteLocale(localeParam)) {
  throw new Error("Invalid locale");
}

const locale = localeParam as SiteLocale;
const content = servicesContentByLocale[locale];
const pageTitle = locale === "zh" ? "出海增长顾问服务｜生姜 Iris" : "Global Growth Advisory Services | Iris Wei";
const pageDescription = locale === "zh"
  ? "面向创业团队的出海增长、开源运营、Product Hunt 发布与创始人定位咨询。先明确问题、交付与边界，再决定合作方式。"
  : "Advisory services for global launch, open-source growth, Product Hunt, and founder positioning. Clarify the decision, scope, and deliverable before starting.";
const decisionRows = locale === "zh"
  ? [
      { need: "出海发布与冷启动", deliverable: "定位、渠道顺序、14 天实验与停止条件", proof: "/zh/insights/first-100-users-without-paid-ads", proofLabel: "前 100 个用户实验" },
      { need: "开源增长与 GitHub", deliverable: "README 转化、发布分发、社区与贡献者路径", proof: "https://tools.gingiris.com/blog/2026/03/25/how-to-get-more-github-stars-the-definitive-guide-33k-stars-case-study/", proofLabel: "GitHub Stars 案例" },
      { need: "竞品与增长决策", deliverable: "证据卡、竞争地图、优先级与下一项实验", proof: "/zh/insights/competitive-analysis-template-startups", proofLabel: "竞品分析模板" },
      { need: "创始人叙事与内容系统", deliverable: "Founder voice、证据边界、内容与转化路径", proof: "/zh/insights/train-ai-brand-voice", proofLabel: "AI 品牌语料系统" },
    ]
  : [
      { need: "Global launch and cold start", deliverable: "Positioning, channel order, a 14-day experiment, and stop conditions", proof: "/en/insights/first-100-users-without-paid-ads", proofLabel: "First 100 users experiment" },
      { need: "Open-source and GitHub growth", deliverable: "README conversion, launch distribution, community, and contributor path", proof: "https://tools.gingiris.com/blog/2026/03/25/how-to-get-more-github-stars-the-definitive-guide-33k-stars-case-study/", proofLabel: "GitHub Stars case study" },
      { need: "Competitive and growth decisions", deliverable: "Evidence cards, a competitive map, priorities, and the next experiment", proof: "/en/insights/competitive-analysis-template-startups", proofLabel: "Competitive analysis template" },
      { need: "Founder narrative and content system", deliverable: "Founder voice, evidence rules, content structure, and conversion path", proof: "/en/insights/train-ai-brand-voice", proofLabel: "AI brand voice system" },
    ];
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: pageTitle,
      description: pageDescription,
      provider: { "@type": "Person", name: "Iris Wei", url: "https://gingiris.com" },
      areaServed: "Worldwide",
      url: `https://gingiris.com/${locale}/services`,
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: locale === "zh" ? "顾问合作方式" : "Advisory engagements",
        itemListElement: content.plans.map((plan) => ({
          "@type": "Offer",
          name: plan.title,
          description: plan.detail,
          url: `https://gingiris.com/${locale}/services#engagements`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: locale === "zh" ? "主页" : "Home", item: `https://gingiris.com/${locale}` },
        { "@type": "ListItem", position: 2, name: locale === "zh" ? "服务" : "Services", item: `https://gingiris.com/${locale}/services` },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: content.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout locale={locale} title={pageTitle} description={pageDescription} structuredData={serviceSchema}>
  <section class="scene scene-hero" data-chapter>
    <div class="page-hero stage-compact" data-stage>
      <div class="page-hero-copy">
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.title}</h1>
        <p>{content.intro}</p>
        <div class="hero-actions">
          <a class="primary-button" href="#engagements">{locale === "zh" ? "查看合作方式" : "View engagements"}</a>
          <a class="ghost-button" href="#contact">{locale === "zh" ? "联系 Iris" : "Contact Iris"}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="scene scene-proof" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{locale === "zh" ? "直接答案" : "Direct answer"}</p>
      <h2>{locale === "zh" ? "出海增长顾问具体交付什么？" : "What does a global growth advisor actually deliver?"}</h2>
      <p>{locale === "zh"
        ? "不是替团队堆更多建议，而是把一个卡住的增长决定转成可执行的证据、优先级、实验和复盘标准。下面是当前最常见的四类问题与对应交付。"
        : "The job is not to add more advice. It is to turn one blocked growth decision into evidence, priorities, an executable experiment, and a review standard. These are the four most common scopes."}</p>
    </div>
    <div class="table-shell" data-reveal>
      <table>
        <thead>
          <tr>
            <th>{locale === "zh" ? "团队问题" : "Team need"}</th>
            <th>{locale === "zh" ? "典型交付" : "Typical deliverable"}</th>
            <th>{locale === "zh" ? "先看证据" : "Review the method"}</th>
          </tr>
        </thead>
        <tbody>
          {decisionRows.map((row) => (
            <tr>
              <td>{row.need}</td>
              <td>{row.deliverable}</td>
              <td><a href={row.proof}>{row.proofLabel}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="scene scene-proof" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{locale === "zh" ? "适用问题" : "Focus areas"}</p>
      <h2>{locale === "zh" ? "先判断问题，再选择服务" : "Diagnose the decision before choosing a service"}</h2>
    </div>
    <div class="service-pillar-grid">
      {content.pillars.map((pillar) => (
        <article class="service-pillar-card" data-reveal>
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="scene scene-invitation" id="engagements" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{locale === "zh" ? "合作入口" : "Engagements"}</p>
      <h2>{locale === "zh" ? "四种清晰的合作方式" : "Four clear ways to work together"}</h2>
      <p>{locale === "zh" ? "价格为当前公开入口；正式合作前仍会确认问题、范围和交付。" : "Published prices are entry points. Scope and deliverables are confirmed before work begins."}</p>
    </div>
    <div class="premium-pricing-grid">
      {content.plans.map((plan, index) => (
        <article class:list={["premium-pricing-card", index === 1 && "is-featured", index === 3 && "is-wide"]} data-reveal>
          <span class="service-preview-index">{String(index + 1).padStart(2, "0")}</span>
          <h3>{plan.title}</h3>
          {plan.subtitle ? <p>{plan.subtitle}</p> : null}
          <strong>{plan.price}</strong>
          <p>{plan.detail}</p>
          <p class="service-delivery-note">{plan.deliveryNote}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="scene scene-proof scene-faq faq-section" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2>{locale === "zh" ? "合作前常见问题" : "Questions before working together"}</h2>
    </div>
    <div class="faq-list">
      {content.faq.map((item) => (
        <details data-reveal>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="scene scene-closing" id="contact" data-chapter>
    <div class="closing-invitation stage-compact" data-stage>
      <div class="closing-copy">
        <p class="eyebrow">{locale === "zh" ? "联系 Iris" : "Contact Iris"}</p>
        <h2>{locale === "zh" ? "从一个明确问题开始" : "Start with one clear question"}</h2>
        <p>{locale === "zh" ? "微信添加 staywildgrow，备注「咨询」并简单说明项目与当前问题。" : "Add staywildgrow on WeChat and include a short note about your project and current decision."}</p>
      </div>
      <figure class="contact-qr-card">
        <Image src={wechatQr} alt={locale === "zh" ? "Iris 微信二维码" : "Iris WeChat QR code"} width={480} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</BaseLayout>
