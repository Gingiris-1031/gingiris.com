---
import {
  homeContentByLocale,
  isSiteLocale,
  projectGroups,
  supportedLocales,
  type SiteLocale,
} from "@yipei/site-content";
import ProjectWall from "../../components/ProjectWall.astro";
import ResourceGrid from "../../components/ResourceGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!localeParam || !isSiteLocale(localeParam)) {
  throw new Error("Invalid locale");
}

const locale = localeParam as SiteLocale;
const content = homeContentByLocale[locale];
const heroSignalIndexes = [0, 2, 3];
const heroSignals = heroSignalIndexes
  .map((index) => content.stats[index])
  .filter(Boolean);
const extendedStats = content.stats.filter((_stat, index) => !heroSignalIndexes.includes(index));
const heroLead = content.introLines[0] ?? "";
const heroSupport = content.introLines.slice(1).join(" ");
const heroRole = content.roleStrong.replace(/^\|\s*/, "");
const heroRoleLead = locale === "zh" ? "创业陪跑｜前 AFFiNE" : "Startup Coach | Ex-AFFiNE";
const heroRoleTail = locale === "zh" ? "联合创始人兼 COO" : "Co-founder & COO";
const homeStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Iris Jiang",
  alternateName: "生姜 Iris",
  url: "https://gingiris.com",
  jobTitle: "Growth Advisor",
  description:
    "Ex-AFFiNE Co-founder & COO. Growth advisor focused on Product Hunt launch, open-source marketing, startup growth, and global expansion.",
  knowsAbout: ["Product Hunt Launch", "Open Source Marketing", "Startup Growth", "Global Expansion"],
  sameAs: [
    "https://github.com/toeverything/AFFiNE",
    "https://www.xiaoyuzhoufm.com/podcast/6774f7f51e823e72d366a543",
  ],
};
const pageCopy =
  locale === "zh"
    ? {
        exploreCta: "查看合作方案",
        contactCta: "联系咨询",
        rangeEyebrow: "覆盖议题",
        rangeTitle: "增长、融资、开源与陪跑，覆盖的是完整经营问题",
        proofEyebrow: "项目案例",
        engagementEyebrow: "合作方式",
        detailCta: "查看详情",
        editorialEyebrow: "内容与资源",
        editorialTitle: "内容、资源与精选入口",
        invitationEyebrow: "开始合作",
        invitationTitle: "用一次深度对话开启合作",
        invitationBody: "从定位、增长到融资策略，把关键问题一次讲清楚。",
        servicesCta: "查看服务方案",
      }
    : {
        exploreCta: "Explore engagements",
        contactCta: "Get in touch",
        rangeEyebrow: "Operating Range",
        rangeTitle: "Growth, fundraising, open source, and coaching in one operating surface",
        proofEyebrow: "Proof Wall",
        engagementEyebrow: "Engagement",
        detailCta: "See details",
        editorialEyebrow: "Editorial Surface",
        editorialTitle: "Content, resources, and curated entry points",
        invitationEyebrow: "Invitation",
        invitationTitle: "Start with a single, focused conversation",
        invitationBody: "Clarify positioning, growth, and fundraising in one deliberate session.",
        servicesCta: "View services",
      };
---

<BaseLayout
  locale={locale}
  title="Gingiris"
  description={content.introLines.join(" ")}
  enableScrollNarrative={false}
  structuredData={homeStructuredData}
>
  <section class="scene scene-hero hero-section" data-chapter>
    <div class="hero-stage stage-tall" data-stage>
      <div class="hero-copy hero-stage-copy">
      <p class="eyebrow">{content.rolePrefix}</p>
      <h1>{content.name}</h1>
      <p class="hero-role" aria-label={heroRole}>
        <span>{heroRoleLead}</span>
        <span class="hero-role-nowrap">{heroRoleTail}</span>
      </p>
      <p class="hero-meta-line">
        <span>{content.baseTag}</span>
        <span aria-hidden="true">•</span>
        <span>{content.focusTag}</span>
      </p>
      <div class="hero-essay">
        <p>{heroLead}</p>
        {heroSupport ? <p>{heroSupport}</p> : null}
      </div>
      <div class="hero-actions">
        <a
          class="primary-button"
          href="#services"
        >
          {pageCopy.exploreCta}
        </a>
        <a class="ghost-button" href="#cooperation">
          {pageCopy.contactCta}
        </a>
      </div>
    </div>
      <div class="hero-stage-visual">
        <div class="hero-portrait">
          <img
            alt={content.name}
            src="/figma-assets/raw/iris-profile.webp"
            width="1066"
            height="1600"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <div class="hero-orbit-badge" aria-hidden="true">
            <span>IRIS</span>
            <span>GROWTH</span>
          </div>
          <span class="hero-spark hero-spark-left" aria-hidden="true">✦</span>
          <span class="hero-spark hero-spark-right" aria-hidden="true">✦</span>
        </div>
      </div>
      <aside class="hero-signal-strip">
        {heroSignals.map((stat) => (
          <article class="hero-signal-item" data-reveal>
            <strong>{stat.value}</strong>
            <div>
              <h2>{stat.title}</h2>
              <p>{stat.subtitle}</p>
            </div>
          </article>
        ))}
      </aside>
    </div>
  </section>

  <section class="scene scene-range stats-section stats-collection" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{pageCopy.rangeEyebrow}</p>
      <h2>{pageCopy.rangeTitle}</h2>
    </div>
    <div class="stats-waterfall">
      {extendedStats.map((stat, index) => (
        <article class:list={["stat-card", index % 3 === 0 && "stat-card-wide"]} data-reveal>
          <strong>{stat.value}</strong>
          <h3>{stat.title}</h3>
          <p>{stat.subtitle}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="scene scene-proof" data-chapter>
    <div class="project-section stage-extended" data-stage>
      <div class="section-heading" data-reveal>
        <p class="eyebrow">{pageCopy.proofEyebrow}</p>
        <h2>{content.projectTitle}</h2>
      </div>
      <ProjectWall groups={projectGroups} locale={locale} />
    </div>
  </section>

  <section class="scene scene-invitation" id="services" data-chapter>
    <div class="pricing-section service-preview-section stage-medium" data-stage>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{pageCopy.engagementEyebrow}</p>
      <h2>{content.consultTitle}</h2>
      <p>{content.consultHint}</p>
    </div>
    <div class="service-preview-grid">
      {content.consultItems.map((item, index) => (
        <article class:list={["service-preview-card", item.id === "growth-pack" && "is-featured"]} data-reveal>
          <div class="service-preview-copy">
            <span class="service-preview-index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            {item.subtitle ? <p>{item.subtitle}</p> : null}
          </div>
          <div class="service-preview-meta">
            <strong>{item.price}</strong>
          </div>
        </article>
      ))}
    </div>
    </div>
  </section>

  <section class="scene scene-atlas" data-chapter>
    <div class="resource-section stage-medium" data-stage>
      <div class="section-heading" data-reveal>
      <p class="eyebrow">{pageCopy.editorialEyebrow}</p>
      <h2>{pageCopy.editorialTitle}</h2>
    </div>
      <ResourceGrid groups={content.sections} />
    </div>
  </section>
  <section class="scene scene-closing" id="cooperation" data-chapter>
    <div class="closing-invitation stage-compact" data-stage>
      <div class="closing-copy">
      <p class="eyebrow">{pageCopy.invitationEyebrow}</p>
      <h2>{pageCopy.invitationTitle}</h2>
      <p>{pageCopy.invitationBody}</p>
    </div>
      <figure class="contact-qr-card">
        <div class="contact-qr-copy">
          <span>{pageCopy.contactCta}</span>
          <strong>{locale === "zh" ? "微信扫码联系" : "Scan on WeChat"}</strong>
          <p>{locale === "zh" ? "添加时请简单备注你的项目与咨询方向。" : "Please include a short note about your project and inquiry."}</p>
        </div>
        <img
          src="/qr/iris-wechat.png"
          alt={locale === "zh" ? "微信联系二维码" : "WeChat contact QR code"}
          width="962"
          height="990"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>
</BaseLayout>
