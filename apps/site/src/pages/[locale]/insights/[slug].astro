---
import { getCollection, render } from "astro:content";
import { isSiteLocale, type SiteLocale } from "@yipei/site-content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("insights");
  return entries.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }));
}

const localeParam = Astro.params.locale;
if (!localeParam || !isSiteLocale(localeParam)) {
  throw new Error("Invalid locale");
}

const locale = localeParam as SiteLocale;
const { entry } = Astro.props;
if (!entry || entry.data.locale !== locale) {
  throw new Error("Insight not found");
}

const { Content } = await render(entry);
const canonical = `https://gingiris.com/${locale}/insights/${entry.data.slug}`;
const alternateLocale = locale === "zh" ? "en" : "zh";
const alternate = `https://gingiris.com/${alternateLocale}/insights/${entry.data.slug}`;
const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: entry.data.title,
      description: entry.data.description,
      datePublished: entry.data.publishedAt.toISOString(),
      dateModified: entry.data.updatedAt.toISOString(),
      author: { "@type": "Person", name: entry.data.author, url: "https://gingiris.com" },
      publisher: { "@type": "Organization", name: "Gingiris", url: "https://gingiris.com" },
      mainEntityOfPage: canonical,
      inLanguage: locale === "zh" ? "zh-CN" : "en",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: locale === "zh" ? "主页" : "Home", item: `https://gingiris.com/${locale}` },
        { "@type": "ListItem", position: 2, name: locale === "zh" ? "洞察" : "Insights", item: `https://gingiris.com/${locale}/insights` },
        { "@type": "ListItem", position: 3, name: entry.data.title, item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: entry.data.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  structuredData={articleSchema}
  alternateUrlOverride={alternate}
>
  <section class="scene scene-hero" data-chapter>
    <div class="page-hero stage-compact" data-stage>
      <div class="page-hero-copy">
        <p class="eyebrow">{entry.data.category}</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
      </div>
    </div>
  </section>

  <section class="scene scene-article" data-chapter>
    <div class="article-layout article-layout-insight">
      <article class="article-card insight-article-card" data-reveal>
        <div class="insight-article-head">
          <time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toISOString().slice(0, 10)}</time>
          <span>{locale === "zh" ? "更新" : "Updated"} {entry.data.updatedAt.toISOString().slice(0, 10)}</span>
        </div>
        <p class="insight-direct-answer">{entry.data.directAnswer}</p>
        <div class="insight-evidence-note">{entry.data.evidenceNote}</div>
        <div class="insight-prose"><Content /></div>
        <section class="insight-faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">{locale === "zh" ? "常见问题" : "Frequently asked questions"}</h2>
          {entry.data.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      </article>
      <aside class="article-aside-card insight-article-aside" data-reveal>
        <p class="editorial-card-kicker">{locale === "zh" ? "下一步" : "Next step"}</p>
        <h2>{locale === "zh" ? "把问题收敛成可执行决定" : "Turn the problem into a decision"}</h2>
        <p class="insight-aside-copy">{entry.data.directAnswer}</p>
        <div class="insight-article-aside-actions">
          <a class="primary-button" href={entry.data.ctaHref}>{entry.data.ctaLabel}</a>
          <a class="insight-inline-link" href={`/${locale}/insights`}>{locale === "zh" ? "返回洞察列表" : "Back to insights"}</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
