---
import {
  editorialContentByLocale,
  insightItemsByLocale,
  isSiteLocale,
  supportedLocales,
  type SiteLocale,
} from "@yipei/site-content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return supportedLocales.flatMap((locale) =>
    insightItemsByLocale[locale].map((item) => ({
      params: { locale, slug: item.slug },
      props: { item },
    })),
  );
}

const localeParam = Astro.params.locale;
if (!localeParam || !isSiteLocale(localeParam)) {
  throw new Error("Invalid locale");
}

const locale = localeParam as SiteLocale;
const item = Astro.props.item ?? insightItemsByLocale[locale].find((entry) => entry.slug === Astro.params.slug);

if (!item) {
  throw new Error("Insight not found");
}

const copy = editorialContentByLocale[locale];
const pageCopy =
  locale === "zh"
    ? {
        highlightsTitle: "快速要点",
        originalKicker: "原文入口",
        originalLead: "站内保留的是快速摘要版，继续深读请直接打开原始内容。",
        openOriginal: "打开原文",
        browseLinks: "查看链接归档",
        backToInsights: "返回文章列表",
      }
    : {
        highlightsTitle: "Key takeaways",
        originalKicker: "Original source",
        originalLead: "This page keeps a concise summary. Open the original source for the full material.",
        openOriginal: "Open original",
        browseLinks: "Browse link archive",
        backToInsights: "Back to insights",
      };
---

<BaseLayout locale={locale} title={item.title} description={item.excerpt}>
  <section class="scene scene-hero" data-chapter>
    <div class="page-hero stage-compact" data-stage>
      <div class="page-hero-copy">
        <p class="eyebrow">{item.category}</p>
        <h1>{item.title}</h1>
        <p>{item.excerpt}</p>
      </div>
    </div>
  </section>

  <section class="scene scene-article article-layout article-layout-insight" data-chapter>
    <article class="article-card article-card-rich insight-article-card" data-reveal>
      <div class="insight-article-head">
        <p class="article-date insight-article-date">{item.publishedAt}</p>
        <p class="insight-source-pill">{item.sourceLabel}</p>
      </div>
      <p class="insight-article-lead">{item.summary}</p>
      <div class="article-actions insight-article-actions">
        <a class="primary-button" href={item.sourceHref} target="_blank" rel="noreferrer">{pageCopy.openOriginal}</a>
        <a class="ghost-button" href={`/${locale}/links#strategy-docs`}>{pageCopy.browseLinks}</a>
      </div>
      <section class="article-points insight-article-points">
        <h2>{pageCopy.highlightsTitle}</h2>
        <ul class="article-point-list">
          {item.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      </section>
    </article>
    <aside class="article-aside-card insight-article-aside" data-reveal>
      <p class="editorial-card-kicker">{pageCopy.originalKicker}</p>
      <h2>{item.sourceLabel}</h2>
      <p class="insight-aside-copy">{pageCopy.originalLead}</p>
      <div class="article-aside-actions insight-article-aside-actions">
        <a class="primary-button" href={item.sourceHref} target="_blank" rel="noreferrer">{pageCopy.openOriginal}</a>
        <a class="insight-inline-link" href={`/${locale}/insights`}>{pageCopy.backToInsights}</a>
      </div>
      <p class="article-aside-note">{copy.insightsTitle}</p>
    </aside>
  </section>
</BaseLayout>
