---
import {
  CATALOG_GROUPS,
  DATA,
  TASK_PACKS,
} from "@yipei/site-content";
import WechatDialog from "../../components/WechatDialog.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [{ params: { locale: "zh" } }];
}

const pageTitle = "出海实战指南｜Gingiris 学习资源";
const pageDescription = "出海增长知识库与系统课程，提供产品发布、渠道获客、企业成交等一线增长方法、模板与案例。";
const faqItems = [
  {
    question: "购买「出海实战指南 · 全套知识库」后，还需要购买按需资料包吗？",
    answer:
      "「出海实战指南 · 全套知识库」已包含「付费需求验证」「出海起号获客」「2B 生意起步」三个资料包及「OPC 起步指南」，无需重复购买。只需要其中一部分内容，可以单独选购对应资料包。",
  },
  {
    question: "第一次做出海项目，应该选「出海实战指南」还是「出海增长系统课」？",
    answer:
      "已有项目，可以直接使用「出海实战指南」。只推进一项任务，选择对应资料包；需要多个阶段的完整方法，选择「出海实战指南 · 全套知识库」。希望先系统理解用户、产品与渠道等基础知识，可以选择小报童合作课程「出海增长系统课」。",
  },
  {
    question: "「出海实战指南 · 全套知识库」包含小报童合作课程「出海增长系统课」吗？",
    answer:
      "不包含。「出海增长系统课」是通过小报童购买的独立合作课程，侧重基础知识与系统理解；「出海实战指南 · 全套知识库」提供执行步骤、框架、模板与案例，两者可根据需要分别购买。",
  },
];
const packCards = [
  {
    title: TASK_PACKS[0].title,
    price: "¥199",
    count: "5 份文档",
    dialogDescription: TASK_PACKS[0].desc,
    question: "用户说想要，真的会付费吗？",
    description: "把竞品研究、用户访谈、产品测试与定价验证串起来，为下一步投入找到依据。",
    tags: ["竞品研究框架", "用户访谈与测试流程", "定价与商业化验证方法"],
    open: "pack-0",
  },
  {
    title: TASK_PACKS[1].title,
    price: "¥329",
    count: "11 份文档",
    dialogDescription: TASK_PACKS[1].desc,
    question: "产品准备好了，怎么发布并找到用户？",
    description: "从发布筹备到渠道运营，查阅每个阶段的执行步骤、内容方法与复盘参考。",
    tags: ["产品发布与 Launch 流程", "KOL、UGC、Reddit 运营方法", "内容分发、社区与增长复盘"],
    open: "pack-1",
  },
  {
    title: TASK_PACKS[2].title,
    price: "¥199",
    count: "5 份文档",
    dialogDescription: TASK_PACKS[2].desc,
    question: "有企业意向客户，怎么把沟通推进成订单？",
    description: "围绕客户信任、需求确认、报价与交付，梳理企业业务从沟通到协作的完整过程。",
    tags: ["2B 成交与交付 SOP", "报价、SOW 与合同核心条款模板", "品牌建设与团队协作方法"],
    open: "pack-2",
  },
];
const learningSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: pageTitle,
      description: pageDescription,
      url: "https://gingiris.com/zh/learning",
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  locale="zh"
  title={pageTitle}
  description={pageDescription}
  structuredData={learningSchema}
  showLocaleAlternates={false}
>
  <div class="learning-page">
    <section class="scene learning-hero">
      <div class="learning-hero-inner">
        <div class="learning-hero-copy">
          <p class="eyebrow">THE GROWTH FIELD GUIDE / 出海增长指南</p>
          <h1>出海增长从这里开始</h1>
          <p>从产品发布到获客，每一步都有实战参考。生姜与 Iris 辅导 80+ 家公司的实战积累，整理成你做项目时用得上的步骤、模板与案例。</p>
          <div class="learning-hero-actions">
            <a class="primary-button" href="#bundle">了解出海增长知识库 ↓</a>
          </div>
        </div>
        <div class="learning-book-art" aria-hidden="true">
          <div class="learning-art-orbit"></div>
          <div class="learning-book">
            <small>THE PLAYBOOK</small>
            <strong>带着问题<br />找到方法</strong>
            <span>GINGIRIS / 01</span>
          </div>
          <div class="learning-sheet">
            <small>出海增长指南</small>
            <strong>LEARN →<br />BUILD →<br />GROW</strong>
            <span></span>
            <span></span>
          </div>
        </div>
      </div>
    </section>

    <section class="scene learning-section" id="bundle" aria-labelledby="bundle-heading">
      <div class="learning-section-inner">
        <div class="section-heading">
          <p class="eyebrow">全套获取</p>
          <h2 id="bundle-heading">出海实战指南 · 全套知识库</h2>
          <p>从第一次出海，到持续推进项目</p>
        </div>
        <div class="learning-full-grid">
          <article class="learning-full-copy">
            <p>需求验证、产品发布、渠道获客、企业成交与服务起步，按当前项目需要查阅。</p>
            <div class="learning-stat-row">
              <span><strong>22</strong>份文档</span>
              <span><strong>28 万＋</strong>字符</span>
            </div>
            <p class="learning-inclusion">包含下方三个资料包＋OPC 起步指南。</p>
            <p class="learning-price">¥599</p>
            <div class="learning-full-actions">
              <button
                class="primary-button"
                type="button"
                data-open="bundle"
                data-catalog-title="出海实战指南 · 全套目录"
                data-catalog-eyebrow="GINGIRIS / 完整目录"
                data-catalog-intro="当前22份文档，按组合整理。以下为章节目录与PDF页码，不含付费正文。"
              >查看详细目录 ↗</button>
              <button class="ghost-button" type="button" data-open="contact">咨询购买 ↗</button>
            </div>
          </article>
          <aside class="learning-membership-card">
            <p class="eyebrow">购买全套，享三项会员权益</p>
            <div class="learning-membership-list">
              <article>
                <h4>知识库永久更新</h4>
                <p>一次购买，持续获取新增的方法、案例与模板。</p>
              </article>
              <article>
                <h4>VIP 同行交流群</h4>
                <p>链接创业者、产品与增长同行，交流经验，积累长期人脉。</p>
              </article>
              <article>
                <h4>专属闭门分享</h4>
                <p>与生姜 Iris 及受邀嘉宾深度交流，拓展实战思路。</p>
              </article>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="scene learning-section" id="packs" aria-labelledby="packs-heading">
      <div class="learning-section-inner">
        <div class="section-heading">
          <p class="eyebrow">知识库内容 · 按需选购</p>
          <h2 id="packs-heading">实战资料，按需选购</h2>
          <p>精选自完整知识库，¥49 起。已购全套，无需重复购买。</p>
        </div>
        <div class="learning-pack-grid">
          {packCards.map((pack) => (
            <article class="learning-pack-card">
              <p class="eyebrow">独立资料包 · 可单独购买</p>
              <h3>{pack.title}</h3>
              <p class="learning-price">{pack.price}</p>
              <p class="learning-pack-count">{pack.count}</p>
              <h4>{pack.question}</h4>
              <p class="learning-pack-description">{pack.description}</p>
              <ul>
                {pack.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <p class="learning-pack-source">精选自完整出海增长知识库</p>
              <div class="learning-card-actions">
                <button
                  class="ghost-button"
                  type="button"
                  data-open={pack.open}
                  data-pack-title={pack.title}
                  data-pack-price={pack.price.replace("¥", "")}
                  data-pack-count={pack.count.replace(" 份文档", "")}
                  data-pack-description={pack.dialogDescription}
                >查看内容与目录 ↗</button>
                <button class="ghost-button" type="button" data-open="contact">咨询购买 ↗</button>
              </div>
            </article>
          ))}
          <article class="learning-opc-card">
            <div>
              <p class="eyebrow">服务起步 / 1 份指南</p>
              <h3>OPC 起步指南</h3>
              <p>把专业能力整理成可出售的服务。已包含在 ¥599 全套中，也可单独购买。</p>
            </div>
            <div class="learning-card-actions">
              <strong class="learning-price">¥49</strong>
              <button
                class="ghost-button"
                type="button"
                data-open="pack-3"
                data-pack-title={TASK_PACKS[3].title}
                data-pack-price={TASK_PACKS[3].price}
                data-pack-count={TASK_PACKS[3].ids.length}
                data-pack-description={TASK_PACKS[3].desc}
              >查看目录 ↗</button>
            </div>
          </article>
        </div>
        <p class="learning-page-note">组合包按内容范围购买；VIP 群、闭门分享及永久更新权益以上方全套说明为准。目录弹窗仅展示章节与页码，不含付费正文。</p>
      </div>
    </section>

    <section class="scene learning-course-section" id="course" aria-labelledby="course-heading">
      <div class="learning-section-inner">
        <article class="learning-course-card">
          <div class="learning-course-card-copy">
            <p class="eyebrow">独立合作课程 · 小报童</p>
            <h2 id="course-heading">出海增长系统课</h2>
            <h3>出海路上的教科书</h3>
            <p>从用户研究、产品定位到渠道选择，系统理解出海增长的基础知识与工作逻辑。18 节主线课＋3 节专题课，配套文稿、音频与课后作业，含 VIP 同行交流群。</p>
            <p class="learning-price">¥299</p>
          </div>
          <a
            class="ghost-button"
            href="https://xiaobot.net/p/Gingiris?refer=29043fdd-91ec-42c2-a88d-cb47d1718826"
            target="_blank"
            rel="noopener noreferrer"
          >前往小报童试读 ↗</a>
        </article>
      </div>
    </section>

    <section class="scene learning-section" aria-labelledby="learning-faq-heading">
      <div class="learning-section-inner">
        <div class="section-heading">
          <p class="eyebrow">FAQ</p>
          <h2 id="learning-faq-heading">常见问题</h2>
        </div>
        <div class="faq-list learning-faq-list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="scene learning-cta-band">
      <div class="learning-cta-inner">
        <div class="learning-cta-copy">
          <p class="eyebrow">GINGIRIS / LEARN & GROW</p>
          <h2>想了解更多出海增长学习资源？</h2>
          <p>内容介绍、选购建议与购买咨询，欢迎添加微信：staywildgrow</p>
        </div>
        <button class="primary-button" type="button" data-open="contact">添加微信咨询购买 ↗</button>
      </div>
      <p class="learning-footer-note">当前内容规模按本地版本提取统计，约 28.7 万字符，含中英文、模板与附录。内容持续更新。</p>
    </section>
  </div>

  <dialog class="learning-catalog-dialog" id="learning-catalog-dialog" aria-labelledby="learning-catalog-title">
    <div class="learning-catalog-head">
      <div>
        <p class="eyebrow" data-catalog-eyebrow>GINGIRIS / 完整目录</p>
        <h2 id="learning-catalog-title" data-catalog-title>出海实战指南 · 全套目录</h2>
      </div>
      <button class="learning-catalog-close" type="button" aria-label="关闭" data-close-catalog>×</button>
    </div>
    <div class="learning-catalog-body">
      <p data-catalog-intro>当前22份文档，按组合整理。以下为章节目录与PDF页码，不含付费正文。</p>
      <p data-catalog-description hidden></p>
      <div class="learning-catalog-groups">
        {CATALOG_GROUPS.map((group, groupIndex) => (
          <details class="learning-catalog-group" data-catalog-group={groupIndex}>
            <summary>
              <strong>{group.title}</strong>
              <span>{group.ids.length} 份</span>
            </summary>
            <div class="learning-catalog-documents">
              {group.ids.map((docId) => {
                const entry = DATA.docs[docId];
                return entry ? (
                  <details class="learning-catalog-document">
                    <summary>
                      <span>{entry.title}</span>
                      <small>{entry.meta}</small>
                    </summary>
                    <ol>
                      {entry.lines.map((line) => (
                        <li style={`--line-level: ${line.level};`}>{line.text}</li>
                      ))}
                    </ol>
                  </details>
                ) : null;
              })}
            </div>
          </details>
        ))}
      </div>
      <div class="learning-card-actions">
        <button class="primary-button" type="button" data-open="contact">添加微信咨询购买 ↗</button>
      </div>
    </div>
  </dialog>
  <WechatDialog locale="zh" />

  <script>
    const catalogDialog = document.querySelector<HTMLDialogElement>("#learning-catalog-dialog");
    const catalogTitle = catalogDialog?.querySelector<HTMLElement>("[data-catalog-title]");
    const catalogEyebrow = catalogDialog?.querySelector<HTMLElement>("[data-catalog-eyebrow]");
    const catalogIntro = catalogDialog?.querySelector<HTMLElement>("[data-catalog-intro]");
    const catalogDescription = catalogDialog?.querySelector<HTMLElement>("[data-catalog-description]");
    let previousFocus: HTMLElement | null = null;
    let bodyOverflow = "";

    function openCatalog(trigger: HTMLElement) {
      if (!catalogDialog || catalogDialog.open) {
        return;
      }

      const type = trigger.dataset.open ?? "";
      const isBundle = type === "bundle";
      const packTitle = trigger.dataset.packTitle ?? "";
      const packPrice = trigger.dataset.packPrice ?? "";
      const packCount = trigger.dataset.packCount ?? "";
      const packDescription = trigger.dataset.packDescription ?? "";

      if (catalogTitle) {
        catalogTitle.textContent = isBundle ? trigger.dataset.catalogTitle ?? "" : packTitle;
      }
      if (catalogEyebrow) {
        catalogEyebrow.textContent = isBundle ? trigger.dataset.catalogEyebrow ?? "" : "GINGIRIS / 任务组合";
      }
      if (catalogIntro) {
        catalogIntro.textContent = isBundle
          ? trigger.dataset.catalogIntro ?? ""
          : `¥${packPrice} · ${packCount} 份指南 · 当前试售价格`;
      }
      if (catalogDescription) {
        catalogDescription.textContent = isBundle ? "" : packDescription;
        catalogDescription.hidden = isBundle;
      }

      const selectedPackIndex = isBundle ? null : Number(type.slice("pack-".length));
      catalogDialog.querySelectorAll<HTMLDetailsElement>("[data-catalog-group]").forEach((group, index) => {
        const isSelectedGroup = selectedPackIndex === index;
        group.hidden = !isBundle && !isSelectedGroup;
        group.open = isBundle ? false : isSelectedGroup;
      });

      previousFocus = trigger;
      bodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      catalogDialog.showModal();
      catalogDialog.scrollTop = 0;
    }

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const catalogTrigger = target?.closest<HTMLElement>('[data-open="bundle"], [data-open^="pack-"]');

      if (catalogTrigger) {
        openCatalog(catalogTrigger);
        return;
      }

      const contactTrigger = target?.closest<HTMLElement>('[data-open="contact"]');
      if (contactTrigger?.closest("#learning-catalog-dialog") && catalogDialog?.open) {
        catalogDialog.close();
        window.setTimeout(() => {
          document.dispatchEvent(new CustomEvent("wechat:open", { detail: contactTrigger }));
        }, 0);
      }
    });

    catalogDialog?.addEventListener("click", (event) => {
      if (event.target === catalogDialog || (event.target instanceof Element && event.target.closest("[data-close-catalog]"))) {
        catalogDialog.close();
      }
    });

    catalogDialog?.addEventListener("close", () => {
      document.body.style.overflow = bodyOverflow;
      if (previousFocus?.isConnected) {
        previousFocus.focus();
      }
    });
  </script>
</BaseLayout>
