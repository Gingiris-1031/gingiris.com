---
import { getCollection } from "astro:content";
import {
  editorialContentByLocale,
  insightItemsByLocale,
  isSiteLocale,
  supportedLocales,
  type SiteLocale,
} from "@yipei/site-content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!localeParam || !isSiteLocale(localeParam)) {
  throw new Error("Invalid locale");
}

const locale = localeParam as SiteLocale;
const copy = editorialContentByLocale[locale];
const articles = (await getCollection("insights"))
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const resources = insightItemsByLocale[locale];
const topicGroups = locale === "zh"
  ? [
      {
        title: "验证市场与冷启动",
        description: "先验证人群、问题和渠道，再决定扩大投入。",
        links: [
          { href: "/zh/insights/competitive-analysis-template-startups", label: "创业公司竞品分析模板" },
          { href: "/zh/insights/customer-interview-template-startups", label: "30 分钟用户访谈证据卡" },
          { href: "/zh/insights/first-100-users-without-paid-ads", label: "零广告获得前 100 个用户" },
        ],
      },
      {
        title: "一人公司与顾问业务",
        description: "把经验包装成边界清晰、可以交付和复购的服务。",
        links: [
          { href: "/zh/insights/consulting-pricing-strategy", label: "顾问定价策略" },
          { href: "/zh/insights/one-person-consulting-business", label: "一人咨询业务系统" },
        ],
      },
      {
        title: "Founder 内容系统",
        description: "把第一方会议、案例和判断变成可追溯的内容资产。",
        links: [
          { href: "/zh/insights/train-ai-brand-voice", label: "训练 AI 学会品牌文风" },
          { href: "/zh/learning", label: "课程与知识库" },
        ],
      },
    ]
  : [
      {
        title: "Validate the market and launch",
        description: "Verify the audience, problem, and channel before scaling investment.",
        links: [
          { href: "/en/insights/competitive-analysis-template-startups", label: "Startup competitive analysis template" },
          { href: "/en/insights/customer-interview-template-startups", label: "30-minute customer interview evidence card" },
          { href: "/en/insights/first-100-users-without-paid-ads", label: "Get the first 100 users without ads" },
        ],
      },
      {
        title: "Solo business and consulting",
        description: "Turn experience into a bounded, deliverable, repeatable offer.",
        links: [
          { href: "/en/insights/consulting-pricing-strategy", label: "Consulting pricing strategy" },
          { href: "/en/insights/one-person-consulting-business", label: "Solo consulting business system" },
        ],
      },
      {
        title: "Founder content systems",
        description: "Turn first-party meetings, cases, and judgment into traceable content assets.",
        links: [
          { href: "/en/insights/train-ai-brand-voice", label: "Train AI on your brand voice" },
          { href: "/en/learning", label: "Courses and knowledge base" },
        ],
      },
    ];
const pageTitle = locale === "zh" ? "出海增长洞察与实战复盘｜生姜 Iris" : "Global Growth Insights and Field Notes | Iris Wei";
const pageDescription = locale === "zh"
  ? "关于一人公司、顾问定价、出海增长、开源运营与 Product Hunt 的第一方实战内容与资料索引。"
  : "First-hand essays and curated resources on solo consulting, global growth, open-source operations, and Product Hunt.";
const collectionSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: pageTitle,
      description: pageDescription,
      url: `https://gingiris.com/${locale}/insights`,
      hasPart: articles.map((entry) => ({ "@type": "Article", headline: entry.data.title, url: `https://gingiris.com/${locale}/insights/${entry.data.slug}` })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: locale === "zh" ? "主页" : "Home", item: `https://gingiris.com/${locale}` },
        { "@type": "ListItem", position: 2, name: copy.insightsTitle, item: `https://gingiris.com/${locale}/insights` },
      ],
    },
  ],
};
---

<BaseLayout locale={locale} title={pageTitle} description={pageDescription} structuredData={collectionSchema}>
  <section class="scene scene-hero" data-chapter>
    <div class="page-hero stage-compact" data-stage>
      <div class="page-hero-copy">
        <p class="eyebrow">{locale === "zh" ? "第一方实战内容" : "First-hand field notes"}</p>
        <h1>{copy.insightsTitle}</h1>
        <p>{pageDescription}</p>
      </div>
    </div>
  </section>

  <section class="scene scene-directory" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{locale === "zh" ? "按问题查找" : "Browse by problem"}</p>
      <h2>{locale === "zh" ? "从你正在做的决策开始" : "Start with the decision in front of you"}</h2>
      <p>{locale === "zh" ? "每个主题簇只连接真实存在、内容完整的页面，不为扩大索引量创建薄页。" : "Each topic cluster links only to complete, live resources rather than creating thin pages for index coverage."}</p>
    </div>
    <div class="insight-topic-grid">
      {topicGroups.map((group) => (
        <nav class="insight-topic-card" aria-label={group.title} data-reveal>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <ul>
            {group.links.map((item) => (
              <li><a href={item.href}>{item.label}<span aria-hidden="true"> →</span></a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </section>

  <section class="scene scene-proof" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{locale === "zh" ? "最新文章" : "Latest articles"}</p>
      <h2>{locale === "zh" ? "完整方法、真实口径、可执行下一步" : "Complete methods, explicit evidence, practical next steps"}</h2>
    </div>
    <div class="editorial-grid editorial-grid-insights">
      {articles.map((entry) => (
        <article class="editorial-card editorial-card-insight" data-reveal>
          <div class="editorial-card-body">
            <p class="editorial-card-kicker">{entry.data.category}</p>
            <h3><a href={`/${locale}/insights/${entry.data.slug}`}>{entry.data.title}</a></h3>
            <p class="insight-card-excerpt">{entry.data.description}</p>
          </div>
          <div class="editorial-card-meta editorial-card-meta-insight">
            <span>{entry.data.publishedAt.toISOString().slice(0, 10)}</span>
            <div class="editorial-card-actions-insight">
              <a href={`/${locale}/insights/${entry.data.slug}`}>{locale === "zh" ? "阅读完整文章" : "Read the full article"}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="scene scene-invitation" data-chapter>
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{locale === "zh" ? "精选资料" : "Curated resources"}</p>
      <h2>{locale === "zh" ? "原始文档、播客与复盘入口" : "Original documents, podcasts, and retrospectives"}</h2>
      <p>{locale === "zh" ? "这些条目直接链接到原始来源，不创建内容薄弱的站内详情页。" : "These cards link to the original source instead of creating thin on-site detail pages."}</p>
    </div>
    <div class="editorial-grid editorial-grid-insights">
      {resources.map((item) => (
        <article class="editorial-card editorial-card-insight" data-reveal>
          <p class="editorial-card-kicker">{item.category}</p>
          <h3>{item.title}</h3>
          <p class="insight-card-excerpt">{item.excerpt}</p>
          <a class="insight-inline-link" href={item.sourceHref} target="_blank" rel="noopener noreferrer">{locale === "zh" ? `查看${item.sourceLabel}` : `Open ${item.sourceLabel}`}</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
