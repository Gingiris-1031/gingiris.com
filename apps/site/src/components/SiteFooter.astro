---
import { externalResourceHrefs, type SiteFrameContent, type SiteLocale } from "@yipei/site-content";

interface Props {
  locale: SiteLocale;
  frame: SiteFrameContent;
}

const { locale, frame } = Astro.props;
const socialQrCodes = [
  { src: "/qr/iris-jike-white.svg", label: locale === "zh" ? "即刻" : "Jike" },
  { src: "/qr/iris-xiaohongshu-white.svg", label: locale === "zh" ? "小红书" : "Xiaohongshu" },
];
const communityQrCodes = [
  { src: "/qr/iris-team-people-fit-latest.svg", label: "Gingiris Team People Fit" },
  { src: "/qr/iris-pmf-ai-era-white.svg", label: "PMF for AI Era" },
];
const footerCopy =
  locale === "zh"
    ? { directory: "站点导航", shop: "品牌文创与从0-1出海实战行动指南", social: "社交媒体", community: "社群", rights: "版权所有" }
    : { directory: "Site directory", shop: "Brand Goods & 0-1 Global Launch Guide", social: "Social Media", community: "Community", rights: "All rights reserved" };
const shopLinks = [
  { href: externalResourceHrefs.wechatShop, label: locale === "zh" ? "微信店铺" : "WeChat Shop" },
  { href: externalResourceHrefs.xiaohongshuShop, label: locale === "zh" ? "小红书店铺" : "Xiaohongshu Shop" },
];
const directoryGroups = locale === "zh"
  ? [
      {
        title: "开始这里",
        links: [
          { href: "/zh/services", label: "咨询服务" },
          { href: "/zh/learning", label: "课程与知识库" },
          { href: "/zh/insights", label: "出海增长文章" },
        ],
      },
      {
        title: "验证与冷启动",
        links: [
          { href: "/zh/insights/competitive-analysis-template-startups", label: "创业公司竞品分析" },
          { href: "/zh/insights/customer-interview-template-startups", label: "用户访谈证据卡" },
          { href: "/zh/insights/first-100-users-without-paid-ads", label: "前 100 个用户" },
        ],
      },
      {
        title: "经营与内容系统",
        links: [
          { href: "/zh/insights/consulting-pricing-strategy", label: "顾问定价" },
          { href: "/zh/insights/one-person-consulting-business", label: "一人咨询业务" },
          { href: "/zh/insights/train-ai-brand-voice", label: "AI 品牌文风" },
        ],
      },
      {
        title: "产品与工具",
        links: [
          { href: "https://tools.gingiris.com/", label: "Growth Tools" },
          { href: "https://tools.gingiris.com/skills/", label: "AI Agent Skills" },
          { href: "https://www.analook.com/", label: "Analook 竞品分析" },
        ],
      },
    ]
  : [
      {
        title: "Start here",
        links: [
          { href: "/en/services", label: "Advisory services" },
          { href: "/en/learning", label: "Courses and knowledge base" },
          { href: "/en/insights", label: "Global growth insights" },
        ],
      },
      {
        title: "Validate and launch",
        links: [
          { href: "/en/insights/competitive-analysis-template-startups", label: "Startup competitive analysis" },
          { href: "/en/insights/customer-interview-template-startups", label: "Customer interview evidence card" },
          { href: "/en/insights/first-100-users-without-paid-ads", label: "First 100 users" },
        ],
      },
      {
        title: "Business and content systems",
        links: [
          { href: "/en/insights/consulting-pricing-strategy", label: "Consulting pricing" },
          { href: "/en/insights/one-person-consulting-business", label: "Solo consulting business" },
          { href: "/en/insights/train-ai-brand-voice", label: "AI brand voice" },
        ],
      },
      {
        title: "Products and tools",
        links: [
          { href: "https://tools.gingiris.com/", label: "Growth Tools" },
          { href: "https://tools.gingiris.com/skills/", label: "AI Agent Skills" },
          { href: "https://www.analook.com/", label: "Analook competitor research" },
        ],
      },
    ];
---

<footer class="site-footer" id="site-contact">
  <section class="site-footer-identity">
    <p class="site-footer-mission-text"><em>Help People Find People Mission Fit</em></p>
  </section>

  <nav class="site-footer-directory" aria-label={footerCopy.directory}>
    {directoryGroups.map((group) => (
      <section class="site-footer-directory-group">
        <p class="site-footer-column-title">{group.title}</p>
        <div class="site-footer-directory-links">
          {group.links.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </section>
    ))}
  </nav>

  <div class="site-footer-grid">
    <nav class="site-footer-column site-footer-shop" aria-label={footerCopy.shop}>
      <p class="site-footer-column-title">{footerCopy.shop}</p>
      {shopLinks.map((item) => (
        <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
      ))}
    </nav>

    <section class="site-footer-qr-group" aria-label={footerCopy.social}>
      <p class="site-footer-column-title">{footerCopy.social}</p>
      <div class="footer-qr-grid">
        {socialQrCodes.map((item) => (
          <figure class="footer-qr-card">
            <img
              src={item.src}
              alt={item.label + " QR code"}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </section>

    <section class="site-footer-qr-group" aria-label={footerCopy.community}>
      <p class="site-footer-column-title">{footerCopy.community}</p>
      <div class="footer-qr-grid">
        {communityQrCodes.map((item) => (
          <figure class="footer-qr-card">
            <img
              src={item.src}
              alt={item.label + " QR code"}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </section>
  </div>

  <div class="site-footer-bottom">
    <span>{frame.brand}</span>
    <span>© 2026 Gingiris {footerCopy.rights}</span>
    <span>{locale === "zh" ? "增长 · 开源 · 出海" : "Growth · Open Source · Global"}</span>
  </div>
</footer>
