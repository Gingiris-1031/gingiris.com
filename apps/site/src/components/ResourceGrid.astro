---
import type { HomeSectionGroup, SiteLocale } from "@yipei/site-content";

interface Props {
  groups: HomeSectionGroup[];
  locale?: SiteLocale;
}

const { groups, locale = "en" } = Astro.props;
// Phones show the first few entries of a long group until the visitor asks for the rest.
const collapsedCount = 4;
const showAllLabel = (count: number) => (locale === "zh" ? `展开全部 ${count} 条` : `Show all ${count}`);
const showLessLabel = locale === "zh" ? "收起" : "Show fewer";
const isExternalHref = (href?: string) => Boolean(href && /^https?:\/\//.test(href));
---

<div class="resource-groups">
  {groups.map((group) => (
    <section class="resource-group" data-reveal>
      <header class="resource-group-head">
        <h3>{group.title}</h3>
      </header>
      <div class="resource-grid">
        {group.items.map((item) => {
          const isExternal = isExternalHref(item.href);

          if (!item.href) {
            return (
              <article class:list={["resource-card", "is-static", item.highlighted && "is-highlighted"]} data-reveal>
                <span class="resource-icon">{item.icon}</span>
                <strong>{item.title}</strong>
                {item.subtitle ? <p>{item.subtitle}</p> : null}
              </article>
            );
          }

          return (
            <a
              class:list={["resource-card", item.highlighted && "is-highlighted"]}
              href={item.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noreferrer" : undefined}
              data-reveal
            >
              <span class="resource-icon">{item.icon}</span>
              <strong>{item.title}</strong>
              {item.subtitle ? <p>{item.subtitle}</p> : null}
            </a>
          );
        })}
      </div>
      {group.items.length > collapsedCount ? (
        <button
          class="resource-group-toggle"
          type="button"
          aria-expanded="false"
          data-label-more={showAllLabel(group.items.length)}
          data-label-less={showLessLabel}
        >
          {showAllLabel(group.items.length)}
        </button>
      ) : null}
    </section>
  ))}
</div>

<noscript>
  <style>
    .resource-grid > * {
      display: grid !important;
    }

    .resource-group-toggle {
      display: none !important;
    }
  </style>
</noscript>

<script>
  document.querySelectorAll<HTMLButtonElement>(".resource-group-toggle").forEach((toggle) => {
    const group = toggle.closest<HTMLElement>(".resource-group");

    toggle.addEventListener("click", () => {
      const expanded = group!.classList.toggle("is-expanded");
      toggle.setAttribute("aria-expanded", String(expanded));
      toggle.textContent = (expanded ? toggle.dataset.labelLess : toggle.dataset.labelMore) ?? "";
      if (!expanded) {
        group!.scrollIntoView({ block: "nearest" });
      }
    });
  });
</script>
