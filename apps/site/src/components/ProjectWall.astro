---
import type { ProjectGroup, SiteLocale } from "@yipei/site-content";

interface Props {
  groups: ProjectGroup[];
  locale?: SiteLocale;
}

const { groups, locale = "en" } = Astro.props;
const wallAriaLabel = locale === "zh" ? "辅导项目案例" : "Coached projects";
const logos = groups.flatMap((group) => group.logos);
const wallNote =
  locale === "zh"
    ? "部分服务企业名单 / 名单持续更新中（排名不分先后）"
    : "Selected clients / Continuously updated (in no particular order)";
---

<div class="project-wall" aria-label={wallAriaLabel}>
  <p class="project-wall-note">{wallNote}</p>
  <div class="project-logo-grid">
    {logos.map((logo) => (
      <figure class="project-card">
        <img alt={logo.name} class="project-logo" src={logo.src} loading="lazy" />
      </figure>
    ))}
  </div>
</div>
