---
import type { SiteLocale } from "@yipei/site-content";
import { siteFrameByLocale } from "@yipei/site-content";
import ScrollNarrative from "../components/ScrollNarrative.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  locale: SiteLocale;
  title: string;
  description: string;
  enableScrollNarrative?: boolean;
  structuredData?: Record<string, unknown>;
}

const { locale, title, description, enableScrollNarrative = false, structuredData } = Astro.props;
const frame = siteFrameByLocale[locale];
const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const alternateLocale = locale === "zh" ? "en" : "zh";
const currentLocalePattern = new RegExp(`^/${locale}(?=/|$)`);
const prefetchedLocalePath = currentLocalePattern.test(currentPath)
  ? currentPath.replace(currentLocalePattern, `/${alternateLocale}`)
  : `/${alternateLocale}`;
const siteOrigin = "https://gingiris.com";
const canonicalUrl = new URL(currentPath, siteOrigin).toString();
const alternateUrl = new URL(prefetchedLocalePath, siteOrigin).toString();
const zhUrl = locale === "zh" ? canonicalUrl : alternateUrl;
const enUrl = locale === "en" ? canonicalUrl : alternateUrl;
const socialImageUrl = new URL("/brand/logo-primary.png", siteOrigin).toString();
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="prefetch" href={prefetchedLocalePath} as="document" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gingiris" />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {structuredData ? (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    ) : null}
    <script is:inline>
      (() => {
        const storageKey = "site-locale-transition";

        try {
          const raw = window.sessionStorage.getItem(storageKey);
          if (!raw) {
            return;
          }

          const saved = JSON.parse(raw);
          const currentPath = `${window.location.pathname}${window.location.search}`;
          const isFresh = typeof saved?.startedAt === "number" && Date.now() - saved.startedAt < 4000;

          if (!isFresh || saved?.targetPath !== currentPath) {
            window.sessionStorage.removeItem(storageKey);
            return;
          }

          document.documentElement.dataset.localeTransition = "in";
          window.sessionStorage.removeItem(storageKey);
        } catch {}
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="cinematic" data-enable-scroll-narrative={enableScrollNarrative ? "true" : undefined}>
    <div class="page-shell">
      <div class="page-aura page-aura-left" aria-hidden="true"></div>
      <div class="page-aura page-aura-right" aria-hidden="true"></div>
      <SiteHeader locale={locale} frame={frame} currentPath={currentPath} />
      <main class="page-main">
        <slot />
      </main>
      <SiteFooter locale={locale} frame={frame} />
    </div>
    {enableScrollNarrative ? <ScrollNarrative /> : null}
    <script is:inline>
      (() => {
        if (document.documentElement.dataset.localeTransition !== "in") {
          return;
        }

        const clearTransition = () => {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              delete document.documentElement.dataset.localeTransition;
            });
          });
        };

        if (document.readyState === "complete") {
          clearTransition();
        } else {
          window.addEventListener("load", clearTransition, { once: true });
        }

        window.setTimeout(() => {
          delete document.documentElement.dataset.localeTransition;
        }, 420);
      })();
    </script>
  </body>
</html>
