---
import type { SiteFrameContent, SiteLocale } from "@yipei/site-content";

interface Props {
  locale: SiteLocale;
  frame: SiteFrameContent;
}

const { locale, frame } = Astro.props;
---

<footer class="site-footer">
  <div>
    <p class="site-footer-mission-text"><em>Help People Find People Mission Fit</em></p>
    <h2>{frame.footer.title}</h2>
  </div>
</footer>
